<launch>
  <arg name="paused" default="false"/>
  <arg name="roller_type" default="simple"/>
  <arg name="command_frame" default="base_link"/>

  <include file="$(find rm_description_for_task)/launch/hero.launch">
    <arg name="load_chassis" value="true"/>
    <arg name="roller_type" value="$(arg roller_type)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <rosparam file="$(find hero_chassis_controller)/config/controllers.yaml"
            command="load"/>
  <param name="controller/hero_chassis_controller/command_frame"
         value="$(arg command_frame)"/>

  <node name="hero_controller_spawner"
        pkg="controller_manager"
        type="spawner"
        output="screen"
        args="controller/hero_chassis_controller controller/joint_state_controller"/>
</launch>
